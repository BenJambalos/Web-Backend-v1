MYSQL_URL=
# For local development, use Railway's public MySQL URL here if MYSQL_URL
# points to a *.railway.internal host.
MYSQL_PUBLIC_URL=
# Or set the individual Railway MySQL variables instead of MYSQL_URL:
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_SSL=false
APP_URL=http://localhost:5173
VITE_GOOGLE_MAPS_API_KEY=
# On Railway Free, Trial, or Hobby, use a transactional email HTTPS API.
# Resend sender must be verified; onboarding@resend.dev is for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMTP_* is also supported on platforms/plans that allow outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# For local testing without SMTP only; never enable in production.
EXPOSE_RESET_TOKEN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Use a long random value in production for signing browser sessions
SESSION_SECRET=replace-with-a-long-random-secret
